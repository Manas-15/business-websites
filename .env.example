# Public site URL used for canonical URLs, Open Graph and the sitemap.
# Set this per client deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com

# Paid client deployments only: lock this deployment to one business from
# src/data/businesses.json. Turns off the admin panel, the switcher cookie and
# /s/ links for other businesses. Leave unset on the demo deployment.
# CLIENT_SLUG=kalinga-kitchen
# Optional: show that business in another variant (e.g. luxury, modern).
# CLIENT_VARIANT=

# Password for the admin panel at /admin (site switcher). Leave unset while
# developing to open the panel without a login; required on hosted deployments.
ADMIN_PASSWORD=change-me

# Set to true in the master repository only, to enable the /preview showcase.
TEMPLATE_PREVIEW=false
